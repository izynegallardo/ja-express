{
    "name": "ja-express",
    "version": "1.0.0",
    "description": "A minimal Express backend boilerplate - auth-ready, MySQL-backed, with a testing setup already wired in.",
    "main": "index.js",
    "scripts": {
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
