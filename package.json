    },
    "homepage": "https://github.com/izynegallardo/ja-express#readme",
    "dependencies": {
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "googleapis": "^174.0.1",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.11.0",
        "multer": "^2.2.0",
        "mysql2": "^3.23.3",
        "nodemailer": "^9.0.5",
        "validator": "^13.15.35",
        "zod": "^4.4.3"
